# ---------------------------------------------------------------------
# Servicio de systemd para Clack
# ---------------------------------------------------------------------
# Hace que el servidor de Clack arranque solo cuando el servidor se
# enciende, y que se levante otra vez si alguna vez se cae.
#
# Se copia en:  /etc/systemd/system/clack.service
# Ojo: revisa que "User" y "WorkingDirectory" coincidan con tu servidor.
# ---------------------------------------------------------------------

[Unit]
Description=Clack — la hora y la temperatura del mundo
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/clack
ExecStart=/usr/bin/node servidor/servidor.js
Environment=NODE_ENV=production
Environment=PORT=3001
Restart=always
RestartSec=5

# El servidor solo puede escribir en lo justo y necesario.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target

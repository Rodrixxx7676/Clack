# ---------------------------------------------------------------------
# Configuración de Caddy para Clack
# ---------------------------------------------------------------------
# Este archivo NO se pega dentro del Caddyfile de n8n. Va aparte, en
# /etc/caddy/conf.d/clack.caddy, y Caddy lo carga solo.
#
# Ventaja: la configuración de n8n queda cerrada para siempre. Si algún
# día hay que apagar Clack, se borra este archivo y ya está: nada más
# se toca.
#
# El instalador (instalar-clack.sh) escribe este archivo con el dominio y
# el puerto que le digas, así que normalmente no hay que editarlo a mano.
#
# Cada aplicación del servidor tendrá un archivo como este, con su propio
# subdominio y su propio puerto. Ver el "registro de aplicaciones" en
# DESPLIEGUE.md.
# ---------------------------------------------------------------------

DOMINIO_DE_CLACK {
	# Comprime las respuestas: la web carga más rápido.
	encode zstd gzip

	# El proxy inverso: de internet hacia el puerto de esta aplicación.
	# Si Caddy corriera dentro de Docker, aquí iría "clack:PUERTO_DE_CLACK".
	reverse_proxy 127.0.0.1:PUERTO_DE_CLACK

	# Cabeceras de seguridad básicas.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output file /var/log/caddy/clack.log
		format console
	}
}
